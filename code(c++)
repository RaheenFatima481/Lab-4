#include <iostream>
#include <string>
#include <sstream>

// Function to check if text contains a specific word
bool containsWord(std::string text, std::string word) {
    return text.find(word) != std::string::npos; }

// Function to reverse a string
std::string reverseString(std::string text) {
    std::string reversed = "";
    for (int i = text.length() - 1; i >= 0; i--) {
        reversed += text[i];
    }
    return reversed;
}
